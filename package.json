{
  "name": "redshift-query-editor",
  "version": "0.1.0",
  "private": true,
  "main": "public/electron-main.js",
  "homepage": "./",
  "scripts": {
    "dev": "node ./node_modules/next/dist/bin/next dev -H 0.0.0.0",
    "build": "node ./node_modules/next/dist/bin/next build",
    "start": "node ./node_modules/next/dist/bin/next start",
    "electron-dev": "electron .",
    "electron-build": "node ./node_modules/next/dist/bin/next build && node scripts/build-electron.js",
    "electron-dist": "node ./node_modules/next/dist/bin/next build && node scripts/build-electron.js"
  },
  "dependencies": {},
  "devDependencies": {
    "@electron/rebuild": "^3.7.2",
    "@monaco-editor/react": "^4.7.0",
    "alasql": "^4.17.2",
    "autoprefixer": "^10",
    "better-sqlite3": "^12.9.0",
    "electron": "^35.7.5",
    "electron-builder": "24.6.4",
    "monaco-editor": "^0.55.1",
    "next": "14.2.3",
    "nodemailer": "^8.0.6",
    "postcss": "^8",
    "react": "^18",
    "react-dom": "^18",
    "react-resizable-panels": "^4.10.0",
    "recharts": "^3.8.1",
    "sql.js": "^1.14.1",
    "tailwindcss": "^3",
    "xlsx": "^0.18.5"
  },
  "build": {
    "appId": "com.alrajhi.rcr-query-editor",
    "productName": "RCR Query Editor",
    "copyright": "Copyright © Al Rajhi Bank",
    "npmRebuild": false,
    "directories": {
      "output": "dist"
    },
    "files": [
      "public/electron-main.js",
      "public/preload.js",
      "package.json"
    ],
    "extraResources": [
      {
        "from": ".next/standalone",
        "to": "next-server"
      }
    ],
    "win": {
      "target": [
        {
          "target": "dir",
          "arch": ["x64"]
        }
      ]
    }
  }
}
